{
  "name": "dsh-sleev",
  "version": "0.1.0-alpha.0",
  "description": "Sleev routing observability for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./telemetry": {
      "types": "./lib/types/shared/telemetry.d.ts",
      "default": "./lib/shared/telemetry.js"
    },
    "./sleev": {
      "types": "./lib/types/host/optimizer/sleev/headers.d.ts",
      "default": "./lib/host/optimizer/sleev/headers.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "format": "prettier --check . --end-of-line auto",
    "format:write": "prettier --write . --end-of-line auto",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm run clean && tsdown && tsc -p tsconfig.build.json",
    "check": "pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "tsdown && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "sleev",
    "context-optimization"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^26.2.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
